# Ignore environment variable files (keep .env.example tracked)
.env
.env.*
!.env.example
!**/.env.example
.env.local
.env.*.local
local.env
*.local.env
web/.env
web/.env.*
!web/.env.example

# Local tooling / IDE secrets (never commit)
.claude/settings.local.json
.claude/*.local.*
.cursor/mcp.json
**/.cursor/mcp.json

# System files
.DS_Store

# Dependency directories
node_modules/
.pnpm-debug.log*

# Build and output directories
.next/
build/
out/
coverage/
studio/dist/
web/test-results/
web/.data/
web/web/.data/

# Debug and log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Miscellaneous
.replit
.playwright-mcp/
*.pem
*.tsbuildinfo

# Vercel
.vercel/
.vercel

# OS / editor
Thumbs.db
*.swp
*~
